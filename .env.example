# Entorno de ejecucion: "development" | "production"
# En "development" se crea el usuario dev/dev1234 al inicializar la base.
# En "production" NO se crea ese usuario.
APP_ENV=development

# Ruta absoluta o relativa al archivo SQLite de usuarios.
# Por defecto: cruzador.db en el directorio de trabajo.
DB_PATH=cruzador.db

# Directorio donde se escriben los logs de auditoria.
# Por defecto: .logs/ relativo al directorio de trabajo.
LOG_DIR=.logs

# Tiempo de inactividad (en minutos) antes de cerrar la sesion automaticamente.
SESSION_TIMEOUT_MINUTES=30

# Maximo de intentos de login fallidos consecutivos antes de bloquear la cuenta.
LOGIN_MAX_ATTEMPTS=5

# Duracion del bloqueo de cuenta por intentos fallidos (en minutos).
LOGIN_LOCKOUT_MINUTES=5
